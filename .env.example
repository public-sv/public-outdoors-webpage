# Public values are embedded in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SITE_URL=https://publicoutdoors.com
# Enable only in Netlify production; previews and local builds stay noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Server-only catalog API configuration. Never prefix these with NEXT_PUBLIC_.
# CATALOG_API_KEY_HEADER defaults to X-API-Key and only needs to be changed if
# the API provider uses a different header name.
CATALOG_API_URL=https://aowlcmxyfvvqbxgykvaj.supabase.co/functions/v1/public-catalog
CATALOG_API_KEY=
CATALOG_API_KEY_HEADER=X-API-Key
