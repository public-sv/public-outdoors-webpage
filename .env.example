# Public values are embedded in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SITE_URL=https://publicoutdoors.com
# Enable only in Netlify production; previews and local builds stay noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Server-only catalog API configuration. Configure these in Netlify, not in git.
CATALOG_API_URL=
CATALOG_API_TOKEN=
